#!/bin/bash
# HardCard Time Machine Discovery - HardCoder Integration
# Phase 0: Dry-run discovery with metrics collection

set -e

# Configuration
HC_ROOT="${HC_ROOT:-$(pwd)}"
DATA_DIR="${HC_ROOT}/data/tm_validation"
PYTHON="${PYTHON:-python3}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log() {
    echo -e "${BLUE}[HardCard TM]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

# Ensure data directory exists
mkdir -p "$DATA_DIR"

# Check dependencies
check_dependencies() {
    log "Checking dependencies..."
    
    if ! command -v tmutil &> /dev/null; then
        error "tmutil not found - Time Machine utilities required"
        exit 1
    fi
    
    if ! command -v "$PYTHON" &> /dev/null; then
        error "$PYTHON not found"
        exit 1
    fi
    
    # Check if we can access Time Machine
    if ! tmutil destinationinfo &> /dev/null; then
        warn "tmutil destinationinfo failed - may not find TM volumes"
    fi
    
    success "Dependencies OK"
}

# Run Phase 0 discovery
run_discovery() {
    local size_limit=${1:-3}
    
    log "Starting Phase 0: Time Machine Discovery"
    log "Size limit: $size_limit snapshots"
    
    # Run the discovery script
    local output_file
    output_file=$("$PYTHON" "$HC_ROOT/tools/tm_indexer/tm_discovery.py" \
        --output-dir "$DATA_DIR" \
        --size-limit "$size_limit" \
        --json-only)
    
    if [[ -f "$output_file" ]]; then
        success "Discovery completed: $output_file"
        
        # Extract key metrics for display
        local total_snapshots total_size_human discovery_duration
        total_snapshots=$(jq -r '.total_snapshots // 0' "$output_file")
        total_size_human=$(jq -r '.total_size_human // "unknown"' "$output_file")
        discovery_duration=$(jq -r '.discovery_duration_seconds // 0' "$output_file")
        
        log "Phase 0 Results:"
        log "  📸 Snapshots found: $total_snapshots"
        log "  💽 Total size: $total_size_human"
        log "  ⏱️  Discovery time: ${discovery_duration}s"
        
        # Check if ready for Phase 1
        if [[ "$total_snapshots" -gt 0 ]]; then
            success "✅ Ready for Phase 1: Metadata crawl"
            log "Next step: hc-tm-index --snapshots 3"
        else
            warn "⚠️  No snapshots found - check Time Machine configuration"
        fi
        
        echo "$output_file"
    else
        error "Discovery failed - no output file generated"
        exit 1
    fi
}

# Show usage
usage() {
    cat << EOF
HardCard Time Machine Discovery - Phase 0

Usage: $0 [OPTIONS]

OPTIONS:
    --size-limit N    Calculate sizes for first N snapshots (default: 3, 0 = all)
    --check          Check dependencies only
    --help           Show this help

EXAMPLES:
    $0                    # Quick discovery (3 snapshots)
    $0 --size-limit 10    # Discovery with 10 snapshots
    $0 --size-limit 0     # Full discovery (all snapshots)

OUTPUT:
    Results saved to: $DATA_DIR/tm_discovery_TIMESTAMP.json
    
NEXT STEPS:
    Phase 1: hc-tm-index --snapshots 3
    Phase 2: hc ingest-sql ~/hc_tm.db
EOF
}

# Parse arguments
SIZE_LIMIT=3
CHECK_ONLY=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --size-limit)
            SIZE_LIMIT="$2"
            shift 2
            ;;
        --check)
            CHECK_ONLY=true
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            error "Unknown option: $1"
            usage
            exit 1
            ;;
    esac
done

# Main execution
main() {
    log "HardCard Time Machine Validation - Phase 0"
    log "Data directory: $DATA_DIR"
    
    check_dependencies
    
    if [[ "$CHECK_ONLY" == "true" ]]; then
        success "Dependency check complete"
        exit 0
    fi
    
    # Run discovery
    local result_file
    result_file=$(run_discovery "$SIZE_LIMIT")
    
    log "Phase 0 complete!"
    log "Results file: $result_file"
    
    # Set up alias for next phase
    log ""
    log "💡 Quick setup for Phase 1:"
    log "  alias hc-tm-index='python3 $HC_ROOT/tools/tm_indexer/tm_index.py'"
    log "  hc-tm-index --db $DATA_DIR/hc_tm.db --snapshots 3"
}

# Run main function
main "$@"