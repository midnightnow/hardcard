# Alexandria Safety API - Makefile for Development and Deployment

.PHONY: help install test lint format docker-build docker-run deploy clean

# Default target
help:
	@echo "Alexandria Safety API - Available Commands:"
	@echo ""
	@echo "Development:"
	@echo "  make install     - Install dependencies"
	@echo "  make test        - Run test suite"
	@echo "  make lint        - Run linting"
	@echo "  make format      - Format code"
	@echo "  make dev         - Start development server"
	@echo ""
	@echo "Docker:"
	@echo "  make docker-build - Build Docker image"
	@echo "  make docker-run  - Run Docker container"
	@echo "  make docker-test - Test Docker image"
	@echo ""
	@echo "Deployment:"
	@echo "  make deploy-dev  - Deploy to development"
	@echo "  make deploy-staging - Deploy to staging"
	@echo "  make deploy-prod - Deploy to production"
	@echo ""
	@echo "Database:"
	@echo "  make db-setup    - Set up database"
	@echo "  make db-migrate  - Run database migrations"
	@echo "  make db-seed     - Seed test data"
	@echo ""
	@echo "Utilities:"
	@echo "  make clean       - Clean up temporary files"
	@echo "  make security    - Run security scan"
	@echo "  make docs        - Generate documentation"

# Variables
PYTHON = python3
PIP = pip3
DOCKER_IMAGE = alexandria-safety-api
DOCKER_TAG = latest
CONTAINER_NAME = alexandria-api

# Development setup
install:
	@echo "Installing dependencies..."
	$(PIP) install -r requirements.txt
	@echo "✅ Dependencies installed"

dev:
	@echo "Starting development server..."
	uvicorn alexandria_fastapi_extended:app --reload --host 0.0.0.0 --port 8080

# Testing
test:
	@echo "Running test suite..."
	pytest test_alexandria_safety.py -v --cov=alexandria_safety_wrapper --cov=alexandria_fastapi_extended
	@echo "✅ Tests completed"

test-coverage:
	@echo "Running tests with detailed coverage..."
	pytest test_alexandria_safety.py -v --cov=alexandria_safety_wrapper --cov=alexandria_fastapi_extended --cov-report=html --cov-report=term
	@echo "📊 Coverage report generated in htmlcov/"

test-fast:
	@echo "Running fast tests only..."
	pytest test_alexandria_safety.py -v -m "not slow"

# Code quality
lint:
	@echo "Running linting..."
	flake8 alexandria_safety_wrapper.py alexandria_fastapi_extended.py
	mypy alexandria_safety_wrapper.py alexandria_fastapi_extended.py --ignore-missing-imports
	@echo "✅ Linting completed"

format:
	@echo "Formatting code..."
	black alexandria_safety_wrapper.py alexandria_fastapi_extended.py test_alexandria_safety.py
	isort alexandria_safety_wrapper.py alexandria_fastapi_extended.py test_alexandria_safety.py
	@echo "✅ Code formatted"

security:
	@echo "Running security scan..."
	bandit -r . -f json -o security-report.json || true
	safety check --json --output safety-report.json || true
	@echo "🔒 Security scan completed"

# Docker operations
docker-build:
	@echo "Building Docker image..."
	docker build -t $(DOCKER_IMAGE):$(DOCKER_TAG) .
	@echo "✅ Docker image built: $(DOCKER_IMAGE):$(DOCKER_TAG)"

docker-run:
	@echo "Running Docker container..."
	docker run -d \
		--name $(CONTAINER_NAME) \
		-p 8080:8080 \
		-e ENV=development \
		$(DOCKER_IMAGE):$(DOCKER_TAG)
	@echo "🐳 Container running: http://localhost:8080"

docker-stop:
	@echo "Stopping Docker container..."
	docker stop $(CONTAINER_NAME) || true
	docker rm $(CONTAINER_NAME) || true
	@echo "⏹️  Container stopped"

docker-test:
	@echo "Testing Docker image..."
	docker run --rm \
		-e ENV=test \
		$(DOCKER_IMAGE):$(DOCKER_TAG) \
		pytest test_alexandria_safety.py -v
	@echo "✅ Docker tests passed"

docker-logs:
	@echo "Showing container logs..."
	docker logs -f $(CONTAINER_NAME)

# Database operations
db-setup:
	@echo "Setting up database..."
	$(PYTHON) -c "
import asyncio
from alexandria_fastapi_extended import DatabaseManager
async def setup():
    db = DatabaseManager('postgresql://alexandria:password@localhost:5432/alexandria_test')
    await db.initialize()
    print('✅ Database setup completed')
asyncio.run(setup())
"

db-migrate:
	@echo "Running database migrations..."
	alembic upgrade head
	@echo "✅ Migrations completed"

db-seed:
	@echo "Seeding test data..."
	$(PYTHON) scripts/seed_test_data.py
	@echo "🌱 Test data seeded"

# Cloud deployment
deploy-dev:
	@echo "Deploying to development environment..."
	gcloud run deploy alexandria-api-dev \
		--source . \
		--platform managed \
		--region us-central1 \
		--allow-unauthenticated \
		--set-env-vars ENV=development
	@echo "🚀 Deployed to development"

deploy-staging:
	@echo "Deploying to staging environment..."
	gcloud run deploy alexandria-api-staging \
		--source . \
		--platform managed \
		--region us-central1 \
		--no-allow-unauthenticated \
		--set-env-vars ENV=staging
	@echo "🚀 Deployed to staging"

deploy-prod:
	@echo "Deploying to production environment..."
	@echo "⚠️  This will deploy to production. Are you sure? (y/N)"
	@read confirm && [ "$$confirm" = "y" ] || exit 1
	gcloud run deploy alexandria-api \
		--source . \
		--platform managed \
		--region us-central1 \
		--no-allow-unauthenticated \
		--set-env-vars ENV=production \
		--cpu 2 \
		--memory 4Gi \
		--min-instances 1 \
		--max-instances 100
	@echo "🚀 Deployed to production"

# Firebase hosting configuration
firebase-deploy:
	@echo "Deploying Firebase hosting configuration..."
	firebase deploy --only hosting
	@echo "🔥 Firebase hosting deployed"

# Documentation
docs:
	@echo "Generating documentation..."
	$(PYTHON) -c "
import json
from alexandria_fastapi_extended import app
with open('api-schema.json', 'w') as f:
    json.dump(app.openapi(), f, indent=2)
print('📚 API schema generated: api-schema.json')
"

# Monitoring setup
monitoring-setup:
	@echo "Setting up monitoring..."
	kubectl apply -f k8s/monitoring.yaml
	@echo "📊 Monitoring configured"

# Quality gates
quality-check: lint test security
	@echo "Running quality checks..."
	@echo "✅ All quality checks passed"

# CI/CD pipeline
ci: install format lint test security docker-build docker-test
	@echo "🔄 CI pipeline completed successfully"

cd: ci deploy-staging
	@echo "🚀 CD pipeline completed successfully"

# Utilities
clean:
	@echo "Cleaning up..."
	find . -type f -name "*.pyc" -delete
	find . -type d -name "__pycache__" -delete
	find . -type d -name ".pytest_cache" -delete
	find . -type f -name ".coverage" -delete
	rm -rf htmlcov/
	rm -rf .mypy_cache/
	rm -f security-report.json safety-report.json
	docker system prune -f
	@echo "🧹 Cleanup completed"

# Development workflow helpers
reset: clean docker-stop
	@echo "Resetting development environment..."
	$(PIP) install -r requirements.txt
	@echo "🔄 Environment reset"

quick-test:
	@echo "Running quick validation test..."
	$(PYTHON) -c "
from alexandria_safety_wrapper import AlexandriaSafetyWrapper, SafetyConfig, MockAIClient, MockKnowledgeGraph
wrapper = AlexandriaSafetyWrapper([MockAIClient()], MockKnowledgeGraph(), [], SafetyConfig())
result = wrapper.execute_safely('Test query', 'INFORMATION')
print(f'✅ Quick test passed: {result.status}')
"

health-check:
	@echo "Checking API health..."
	curl -f http://localhost:8080/healthz || echo "❌ API not responding"
	curl -f http://localhost:8080/readyz || echo "❌ API not ready"

load-test:
	@echo "Running load test..."
	$(PYTHON) -c "
import time
import requests
import threading
def test_worker():
    try:
        resp = requests.get('http://localhost:8080/healthz', timeout=5)
        print(f'Response: {resp.status_code}')
    except Exception as e:
        print(f'Error: {e}')

threads = [threading.Thread(target=test_worker) for _ in range(10)]
start = time.time()
for t in threads: t.start()
for t in threads: t.join()
print(f'⚡ Load test completed in {time.time() - start:.2f}s')
"

# Performance optimization
optimize:
	@echo "Running performance optimization..."
	$(PYTHON) -m cProfile -o profile.stats alexandria_fastapi_extended.py
	@echo "📈 Performance profile generated: profile.stats"

# Development shortcuts
run: dev
build: docker-build
logs: docker-logs
stop: docker-stop