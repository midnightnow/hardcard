{
  "filter_paths": "node_modules|test|scripts|migrations",
  "exclude_informational": false,
  "exclude_low": false,
  "exclude_medium": false,
  "exclude_high": false,
  "exclude_optimization": false,
  "fail_on": "high",
  "compile_force_framework": "hardhat",
  "detectors_to_run": [
    "abiencoderv2-array",
    "arbitrary-send-erc20",
    "arbitrary-send-eth",
    "controlled-array-length",
    "controlled-delegatecall",
    "delegatecall-loop",
    "msg-value-loop",
    "reentrancy-eth",
    "reentrancy-no-eth",
    "reentrancy-unlimited-gas",
    "storage-array",
    "unchecked-transfer",
    "weak-prng",
    "incorrect-equality",
    "locked-ether",
    "mapping-deletion",
    "shadowing-abstract",
    "tautology",
    "write-after-write",
    "boolean-cst",
    "constant-function-asm",
    "constant-function-state",
    "divide-before-multiply",
    "reentrancy-benign",
    "reentrancy-events",
    "return-bomb",
    "timestamp",
    "too-many-digits",
    "tx-origin",
    "unchecked-lowlevel",
    "unchecked-send",
    "uninitialized-local",
    "unused-return",
    "incorrect-modifier",
    "shadowing-builtin",
    "shadowing-local",
    "uninitialized-state",
    "uninitialized-storage",
    "unprotected-upgrade",
    "codex",
    "dead-code",
    "solc-version",
    "similar-names",
    "unused-state",
    "complex-function",
    "excessive-loop-iterations",
    "costly-loop",
    "cyclomatic-complexity",
    "suicidal",
    "unprotected-setter",
    "oracle-price-manipulation"
  ],
  "printers_to_run": [
    "human-summary",
    "contract-summary",
    "function-summary",
    "inheritance-graph"
  ],
  "hardhat_cache_directory": "./cache",
  "hardhat_artifacts_directory": "./artifacts"
}