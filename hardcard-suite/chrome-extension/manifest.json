{
  "manifest_version": 3,
  "name": "HARDCARD Memory Assistant",
  "version": "1.0.0",
  "description": "🧠 HARDCARD Memory brings persistent context to your AI conversations. Share memories across ChatGPT, Claude, Perplexity, and more! ✨",
  
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://www.perplexity.ai/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://poe.com/*",
    "https://you.com/*",
    "https://character.ai/*",
    "https://api.hardcard.ai/*",
    "https://hardcard.ai/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["scripts/claude.js"],
      "css": ["styles/common.css"]
    },
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["scripts/chatgpt.js"],
      "css": ["styles/common.css"]
    },
    {
      "matches": ["https://www.perplexity.ai/*"],
      "js": ["scripts/perplexity.js"],
      "css": ["styles/common.css"]
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["scripts/gemini.js"],
      "css": ["styles/common.css"]
    },
    {
      "matches": ["https://poe.com/*"],
      "js": ["scripts/poe.js"],
      "css": ["styles/common.css"]
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "HARDCARD Memory Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.html",
        "icons/*",
        "styles/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}