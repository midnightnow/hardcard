# HardCard Nexus Configuration

# Environment (development/production)
ENVIRONMENT=development

# Firebase Config (Optional - for Auth)
# DATABUTTON_EXTENSIONS=[{"name":"firebase-auth","config":{"firebaseConfig":{"projectId":"hardcard-world"}}}]

# Nexus Settings
NEXUS_STORAGE_PATH=.hardcard/nexus
NEXUS_LEDGER_FILE=signals.json

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","https://hardcard.world"]
